# Copy this file to .env for `vercel dev`, and add the same three values in
# Vercel > Project > Settings > Environment Variables. Never commit the real .env.

# Public project URL, for example https://abcdxyz.supabase.co
SUPABASE_URL=

# SECRET key (sb_secret_... or the legacy service_role key). Server only.
SUPABASE_SECRET_KEY=

# PUBLISHABLE key (sb_publishable_... or the legacy anon key). Safe for browsers.
SUPABASE_PUBLISHABLE_KEY=
